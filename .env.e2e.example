# E2E environment template.
#
# DO NOT copy this file to `.env.e2e.local` and commit it. Create your own
# `.env.e2e.local` (git-ignored) from this template, then run:
#
#   npm run test:e2e
#
# All values are REQUIRED. The E2E runner fails closed if any is missing.
#
# Isolation rules enforced by `e2e/support/environment.ts`:
#   - targets must NOT be production (hostname/path must be local, preview,
#     test, or dev);
#   - TEST_DATABASE_URL must differ from DATABASE_URL;
#   - E2E_NEON_AUTH_BASE_URL must differ from NEON_AUTH_BASE_URL;
#   - E2E_TEST_TARGET_ID must equal E2E_AUTH_TEST_TARGET_ID (same Neon
#     branchable Auth target used for both the isolated database branch and
#     the Auth test target).

# Local dev server URL used as baseURL and NEXT_PUBLIC_APP_URL.
E2E_BASE_URL=http://127.0.0.1:3100

# Neon branchable target id (same value for database and Auth).
E2E_TEST_TARGET_ID=replace-with-neon-branchable-target-id
E2E_AUTH_TEST_TARGET_ID=replace-with-neon-branchable-target-id

# Neon Auth base URL for the isolated test target (NOT the app endpoint).
E2E_NEON_AUTH_BASE_URL=https://auth-test-target.example.neon.tech

# Two isolated user fixtures (one per test account).
E2E_USER_A_EMAIL=replace-with-user-a-email
E2E_USER_A_PASSWORD=replace-with-user-a-password-min-8-chars
E2E_USER_B_EMAIL=replace-with-user-b-email
E2E_USER_B_PASSWORD=replace-with-user-b-password-min-8-chars

# Application database (isolated Neon branch) served by the webServer.
DATABASE_URL=postgresql://user:password@isolated-branch.example.neon.tech/db

# Separate integration-test database; must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@separate-test-db.example.neon.tech/db
