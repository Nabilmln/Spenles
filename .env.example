# Public application metadata
NEXT_PUBLIC_APP_NAME=Spenles
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Neon PostgreSQL connection
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server-only Neon Auth configuration
NEON_AUTH_BASE_URL=https://your-auth-endpoint.example.com
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Optional report email delivery. Required to send PDF reports by email.
# Verify the sender domain with Resend before using it in production.
RESEND_API_KEY=
REPORT_EMAIL_FROM=reports@your-verified-domain.example

# Integration tests must use a separate Neon branch or database.
TEST_DATABASE_URL=postgresql://user:password@test-host/test-database?sslmode=require
